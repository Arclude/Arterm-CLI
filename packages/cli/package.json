{
  "name": "arterm-cli",
  "version": "0.4.0",
  "description": "Local AI coding agent for your terminal — Ollama, llama.cpp, and OpenAI-compatible providers, a rich Ink TUI, and permission-gated file/shell tools.",
  "type": "module",
  "bin": {
    "arterm": "dist/main.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Arclude",
  "homepage": "https://github.com/Arclude/Arterm-CLI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arclude/Arterm-CLI.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Arclude/Arterm-CLI/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "ollama",
    "llama.cpp",
    "openai",
    "tui",
    "ink",
    "local-llm",
    "terminal"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "tsup",
    "arterm": "node dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.70",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.2",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "json5": "^2.2.3",
    "react": "^18.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@arterm/core": "workspace:*",
    "@arterm/memory": "workspace:*",
    "@arterm/providers": "workspace:*",
    "@arterm/tools": "workspace:*",
    "@arterm/tui": "workspace:*"
  }
}
