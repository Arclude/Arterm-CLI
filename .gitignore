# Benchmark run outputs (one directory per trial: config, log, result). These
# are local measurements, not repository content. They were covered by the
# removed TypeScript tree's .gitignore, and without this line the first
# `git add -A` after the restructure staged 304 of them.
/jobs/

# Stray experiment/debug artifacts at the repo root. Real assets live under
# assets/, docs/, ios/, and tests/ and are committed explicitly.
/*.log
/*.avif
/*.mp4
/*.png
